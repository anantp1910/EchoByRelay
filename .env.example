# Relay environment. Names only: put values in .env.local (never commit) and
# in the Vercel project settings. Only NEXT_PUBLIC_* values reach the browser.

# Supabase (Postgres + Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Grok (primary AI, xAI OpenAI-compatible API). Model names only from env.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_REASONING_MODEL=
GROK_FAST_MODEL=

# Gemini (backup AI, called once after Grok fails). Native generateContent
# endpoint; new "AQ." keys work there via the x-goog-api-key header.
GEMINI_API_KEY=
GEMINI_MODEL=

# ElevenLabs speech-to-text (doctor dictation). Model defaults to scribe_v2.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=

# Backboard (care-circle "Ask about Maria" thread memory)
BACKBOARD_API_KEY=
# Optional: reuse a known assistant instead of find-or-create by name
BACKBOARD_ASSISTANT_ID=
# Optional: "true" to answer with Backboard's own chat (needs paid LLM credits);
# otherwise notes are read from Backboard and Grok/Gemini writes the answer
BACKBOARD_CHAT=
BACKBOARD_LLM_PROVIDER=
BACKBOARD_MODEL=

# Demo: "true" = offline fixtures + templates (no live AI). Keep false in production.
DEMO_MODE=false

# Visa: simulated flow. The sandbox path is not implemented; keep false.
USE_VISA_SANDBOX=false
# Unused by the app today (kept for the planned sandbox / HEARSAY service)
VISA_API_KEY=
HEARSAY_URL=
HEARSAY_BLOCK_THRESHOLD=
